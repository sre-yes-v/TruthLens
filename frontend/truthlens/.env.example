##############################################################################
# TruthLens frontend — environment configuration
#
# Copy this file to `.env.local` and adjust. `.env.local` is git-ignored;
# this file is committed as the documented list of every variable the app
# reads. Never put a secret in either: NEXT_PUBLIC_* values are compiled
# into the JavaScript bundle and are visible to anyone using the site.
##############################################################################

# Base URL of the FastAPI backend, WITHOUT the /api/v1 suffix — the API
# client adds that itself. No trailing slash.
#
#   local development : http://localhost:8000
#   Docker Compose    : http://backend:8000
#   deployed          : https://api.your-domain.example
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Serve every API call and the SSE stream from the in-memory mock adapter
# in `src/mocks/` instead of the network.
#
# Set to `true` to develop or demo the whole frontend with no backend
# running. It also enables the "Or try a sample" chips on the upload page,
# which map to the four sample report cases.
#
# Set to `false` (or leave unset) to talk to the real FastAPI backend.
NEXT_PUBLIC_USE_MOCK_API=false

# Shows the "Prototype map" floating panel — a reviewer aid that jumps
# straight to any UI state (report variants, failure, expired, 409, admin).
#
# Keep this `false` for anything users will see. Turn it on for a project
# demo or viva, so every state can be shown without staging the conditions
# that produce it.
NEXT_PUBLIC_ENABLE_PROTOTYPE_TOOLS=false
